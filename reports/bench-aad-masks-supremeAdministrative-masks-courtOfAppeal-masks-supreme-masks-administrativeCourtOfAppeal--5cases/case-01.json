        {
          "id": "P000010",
          "ordinal": 10,
          "text": "• Όροι χρήσης",
          "startOffset": 270,
          "endOffset": 283,
          "relativePosition": 0.28125,
          "parentBlockId": "B00010",
          "sourceLineStart": 28,
          "sourceLineEnd": 28,
