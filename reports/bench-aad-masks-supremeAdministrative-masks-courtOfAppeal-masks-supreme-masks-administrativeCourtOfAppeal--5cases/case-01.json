            "listCandidate": true,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000011",
          "ordinal": 11,
          "text": "Αναφορικά με το Cylaw",
          "startOffset": 288,
          "endOffset": 309,
          "relativePosition": 0.3125,
          "parentBlockId": "B00011",
          "sourceLineStart": 31,
          "sourceLineEnd": 31,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.111,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000012",
          "ordinal": 12,
          "text": "Το CyLaw είναι η διαδικτυακή υπηρεσία του Κυπριακού Ινστιτούτου Νομικής Πληροφόρησης (ΚΙΝΟΠ/CyLII) η οποία προσφέρει ελεύθερη και μη κερδοσκοπική πρόσβαση στις κυπριακές και σε διεθνείς πηγές δικαίου.",
          "startOffset": 312,
          "endOffset": 512,
          "relativePosition": 0.34375,
          "parentBlockId": "B00012",
          "sourceLineStart": 34,
          "sourceLineEnd": 34,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.094,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000013",
          "ordinal": 13,
          "text": "Τα έξοδα ανάπτυξης και λειτουργίας του CyLaw καλύπτονται από τους δικηγόρους μέσω του Παγκύπριου Δικηγορικού Συλλόγου.",
          "startOffset": 515,
          "endOffset": 633,
          "relativePosition": 0.375,
          "parentBlockId": "B00013",
          "sourceLineStart": 37,
          "sourceLineEnd": 37,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.059,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000014",
          "ordinal": 14,
          "text": "Οι βάσεις δεδομένων του CyLaw περιλαμβάνουν όλη τη νομολογία του Ανωτάτου Δικαστηρίου, την ενοποιημένη και αριθμημένη νομοθεσία καθώς και τους θεσμούς πολιτικής δικονομίας, μέρος της δευτερογενούς νομοθεσίας και αποφάσεων διαιτητικών οργάνων",
          "startOffset": 636,
          "endOffset": 877,
          "relativePosition": 0.40625,
          "parentBlockId": "B00014",
          "sourceLineStart": 40,
          "sourceLineEnd": 40,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.024,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000015",
          "ordinal": 15,
          "text": "Το Cylaw είναι μέλος του Διεθνούς Κινήματος για την Ελεύθερη Πρόσβαση στο Νόμο από το 2004 και έχει στενή συνεργασία με αντίστοιχους οργανισμούς άλλων χωρών. Το Cylaw συνεργάζεται με άλλες διεθνείς διαδικτυακές υπηρεσίες νομικής πληροφόρησης όπως την ενιαία μηχανή αναζήτησης του Δικτύου των Προέδρων των Ανωτάτων Δικαστηρίων της Ευρωπαϊκής Ένωσης, το WorldLii και το CommonLii ενώ συμμετέχει στην πρωτοβουλία για τη δημιουργία μιας πανευρωπαϊκής υπηρεσίας νομικής πληροφόρησης EuroLii.",
          "startOffset": 879,
          "endOffset": 1365,
          "relativePosition": 0.4375,
          "parentBlockId": "B00015",
          "sourceLineStart": 42,
          "sourceLineEnd": 42,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.049,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000016",
          "ordinal": 16,
          "text": "Ιστορικό",
          "startOffset": 1368,
          "endOffset": 1376,
          "relativePosition": 0.46875,
          "parentBlockId": "B00016",
          "sourceLineStart": 45,
          "sourceLineEnd": 45,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.125,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000017",
          "ordinal": 17,
          "text": "To Cylaw ιδρύθηκε τον Ιανουάριο 2002 ως μια προσωπική πρωτοβουλία από τον δικηγόρο Λάρη Βραχίμη και καθιερώθηκε ως η κύρια πηγή ελεύθερης νομικής πληροφόρησης στην Κύπρο.",
          "startOffset": 1379,
          "endOffset": 1549,
          "relativePosition": 0.5,
          "parentBlockId": "B00017",
          "sourceLineStart": 48,
          "sourceLineEnd": 48,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.043,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000018",
          "ordinal": 18,
          "text": "Το 2011 η υπηρεσία παραχωρήθηκε δωρεάν, προς όφελος των δικηγόρων, στο Κυπριακό Ινστιτούτο Νομικής Πληροφόρησης το οποίο ανέλαβε τη συνέχιση της λειτουργίας της και παράλληλα την αναβάθμιση των παρεχομένων υπηρεσιών και επέκταση των βάσης δεδομένων της ώστε αυτές να περιλάβουν όλες τις πρωτογενείς πηγές του Κυπριακού δικαίου.",
          "startOffset": 1550,
          "endOffset": 1877,
          "relativePosition": 0.53125,
          "parentBlockId": "B00017",
          "sourceLineStart": 48,
          "sourceLineEnd": 48,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.022,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000019",
          "ordinal": 19,
          "text": "Στα πλαίσια αυτά το ΚΙΝΟΠ ανέλαβε το έργο της επεξεργασίας και ενοποίησης της Κυπριακής Νομοθεσίας ώστε αυτή να ενσωματωθεί στις βάσεις δεδομένων του CyLaw.",
          "startOffset": 1880,
          "endOffset": 2036,
          "relativePosition": 0.5625,
          "parentBlockId": "B00018",
          "sourceLineStart": 50,
          "sourceLineEnd": 50,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.076,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000020",
          "ordinal": 20,
          "text": "Η υλοποίηση του έργου κατέστη δυνατή λόγω της δωρεάς που έγινε προς του Σύλλογο από τον δικηγόρο Νόντα Κορακίδη της δεκαπεντάτομης συλλογής Ενοποιημένης Κυπριακής Νομοθεσίας την οποία είχε εκδώσει τα έτη 1999-2000.",
          "startOffset": 2037,
          "endOffset": 2251,
          "relativePosition": 0.59375,
          "parentBlockId": "B00018",
          "sourceLineStart": 50,
          "sourceLineEnd": 50,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.04,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000021",
          "ordinal": 21,
          "text": "Το Διοικητικό Συμβούλιο του ΚΙΝΟΠ/CyLii",
          "startOffset": 2253,
          "endOffset": 2292,
          "relativePosition": 0.625,
          "parentBlockId": "B00019",
          "sourceLineStart": 52,
          "sourceLineEnd": 52,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.294,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000022",
          "ordinal": 22,
          "text": "Το Κυπριακό Ινστιτούτο Νομικής Πληροφόρησης είναι εγγεγραμμένο ως μη κερδοσκοπική εταιρεία χωρίς μετοχικό κεφάλαιο.",
          "startOffset": 2295,
          "endOffset": 2410,
          "relativePosition": 0.65625,
          "parentBlockId": "B00020",
          "sourceLineStart": 55,
          "sourceLineEnd": 55,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.05,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000023",
          "ordinal": 23,
          "text": "Η διεθνής ονομασία του Ινστιτούτου είναι Cyprus Legal Information Institute (CyLii).",
          "startOffset": 2411,
          "endOffset": 2495,
          "relativePosition": 0.6875,
          "parentBlockId": "B00020",
          "sourceLineStart": 55,
          "sourceLineEnd": 55,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.113,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000024",
          "ordinal": 24,
          "text": "Από τα επτά μέλη του, τα πέντε διορίζονται από τον Παγκύπριο Δικηγορικό Σύλλογο και τα άλλα δυο από το Κυπριακό Ερευνητικό Ινστιτούτο Νομικής Πληροφόρησης που είναι η ερευνητική πτέρυγα του Cylaw. Τα μέλη του Διοικητικού Συμβουλίου του ΚΙΝΟΠ/CyLii είναι:",
          "startOffset": 2496,
          "endOffset": 2750,
          "relativePosition": 0.71875,
          "parentBlockId": "B00020",
          "sourceLineStart": 55,
          "sourceLineEnd": 55,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.094,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000025",
          "ordinal": 25,
          "text": "Δώρος Ιωαννίδης, δικηγόρος και τέως Πρόεδρος του Παγκύπριου Δικηγορικού Σύλλογου, Πρόεδρος",
          "startOffset": 2753,
          "endOffset": 2843,
          "relativePosition": 0.75,
          "parentBlockId": "B00021",
          "sourceLineStart": 58,
          "sourceLineEnd": 58,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.09,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000026",
          "ordinal": 26,
          "text": "Andrew Mowbray, Καθηγητής, Διευθυντής του Australasian Legal Information Institute (Austlii)",
          "startOffset": 2845,
          "endOffset": 2937,
          "relativePosition": 0.78125,
          "parentBlockId": "B00022",
          "sourceLineStart": 60,
          "sourceLineEnd": 60,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.114,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000027",
          "ordinal": 27,
          "text": "Λάρης Βραχίμης, Δικηγόρος",
          "startOffset": 2939,
          "endOffset": 2964,
          "relativePosition": 0.8125,
          "parentBlockId": "B00023",
          "sourceLineStart": 62,
          "sourceLineEnd": 62,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.136,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000028",
          "ordinal": 28,
          "text": "Κυριάκος Θεοδωρίδης, Δικηγόρος",
          "startOffset": 2966,
          "endOffset": 2996,
          "relativePosition": 0.84375,
          "parentBlockId": "B00024",
          "sourceLineStart": 64,
          "sourceLineEnd": 64,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.111,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000029",
          "ordinal": 29,
          "text": "Διομήδης Καλλής, Δικηγόρος",
          "startOffset": 2998,
          "endOffset": 3024,
          "relativePosition": 0.875,
          "parentBlockId": "B00025",
          "sourceLineStart": 66,
          "sourceLineEnd": 66,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.13,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000030",
          "ordinal": 30,
          "text": "Χριστόφορος Χριστοφή, Δικηγόρος",
          "startOffset": 3026,
          "endOffset": 3057,
          "relativePosition": 0.90625,
          "parentBlockId": "B00026",
          "sourceLineStart": 68,
          "sourceLineEnd": 68,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.107,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000031",
          "ordinal": 31,
          "text": "Νικόλας Κουκούνης, Δικηγόρος\nΓραμματέας του Ινστιτούτου είναι η Κούλια Βάκη, Νομικός, Εκτελεστική Διευθύντρια του Παγκυπρίου Δικηγορικού Συλλόγου",
          "startOffset": 3059,
          "endOffset": 3204,
          "relativePosition": 0.9375,
          "parentBlockId": "B00027",
          "sourceLineStart": 70,
          "sourceLineEnd": 71,
          "formatting": {
            "bold": false,
            "italic": false,
            "centered": false,
            "uppercaseRatio": 0.103,
            "headingCandidate": false,
            "listCandidate": false,
            "paragraphNumber": "",
            "htmlPath": ""
          }
        },
        {
          "id": "P000032",
          "ordinal": 32,
          "text": "Το Κυπριακό Ερευνητικό Ινστιντούτο Νομικής Πληροφόρησης περιλαμβάνει επίσης στο Διοικητικό Συμβούλιο του τους Philip Chung, Εκτελεστικό Διευθυντή του Austlii και τον Νικήτα Χατζημιχαήλ, Επίκουρο Καθηγητή Νομικής του Πανεπιστημίου Κύπρου.",
          "startOffset": 3207,
          "endOffset": 3444,
          "relativePosition": 0.96875,
          "parentBlockId": "B00028",
          "sourceLineStart": 74,
          "sourceLineEnd": 74,
          "formatting": {
